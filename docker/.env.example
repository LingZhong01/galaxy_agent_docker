# Runtime backend: codex or claude
AGENT_BACKEND=codex
# Do not let packages under the persisted /home/agent/.local override the
# image's verified JAX/GalfitS environment.
PYTHONNOUSERSITE=1
MAX_CONCURRENT_CODEX_WORKERS=1
AGENT_TIMEOUT_SEC=7200
AGENT_STREAM_LIMIT_BYTES=16777216

# MCP startup and same-container callback
COMMUNICATION_SERVICE_PUBLIC_URL=http://127.0.0.1:8010
MCP_TIMEOUT=120000
MCP_CONNECT_TIMEOUT_MS=120000

# Platform/OSS endpoints
COMMUNICATION_FILE_BACKEND=auto
COMMUNICATION_OSS_BASE_URL=https://platform.example.com/api/csst
COMMUNICATION_OSS_DOWNLOAD_PATH=/fitting/v2/oss/files/download
COMMUNICATION_OSS_UPLOAD_PATH=/fitting/v2/oss/files
COMMUNICATION_OSS_FOLDER_UPLOAD_PATH=/fitting/v2/oss/folders
COMMUNICATION_OSS_TIMEOUT_SEC=300

# Staging retention
STAGE_CLEANUP_ENABLED=true
STAGE_RETENTION_DAYS=30
STAGE_CLEANUP_INTERVAL_HOURS=24

# Optional backend settings
CODEX_LOAD_CLAUDE_PROJECT=true
# CLAUDE_MODEL=sonnet
# CLAUDE_MAX_BUDGET_USD=

# Optional VLM analysis used by MCP image/residual analysis tools.
# Keep real credentials only in the runtime .env (chmod 600); never bake them
# into the image or commit them with .mcp.json.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# ANALYSIS_MODE=vlm
# MCP_ALLOWED_HOSTS=*
