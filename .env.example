# File staging and persistent service data
GALAXY_DATA_ROOT=/mnt/data
GALAXY_MCP_ROOT=/opt/galaxy_morphology_mcp
LOCAL_GALFIT_STAGE_ROOT=/var/lib/communication-service/staging
STAGE_CLEANUP_ENABLED=true
STAGE_RETENTION_DAYS=30
STAGE_CLEANUP_INTERVAL_HOURS=24
COMMUNICATION_SERVICE_DB=/var/lib/communication-service/communication_service.sqlite3
COMMUNICATION_SERVICE_LOG_DIR=/var/log/communication-service
# MCP 子进程向 communication service 回传拟合事件时使用的访问地址，不是服务监听地址。
# 同机部署使用 127.0.0.1；跨容器部署改成可解析的服务名，例如 http://communication-service:8010。
COMMUNICATION_SERVICE_PUBLIC_URL=http://127.0.0.1:8010

# Platform file backend
COMMUNICATION_FILE_BACKEND=auto
COMMUNICATION_OSS_BASE_URL=https://platform.example.com/api/csst
COMMUNICATION_OSS_DOWNLOAD_PATH=/fitting/v2/oss/files/download
COMMUNICATION_OSS_UPLOAD_PATH=/fitting/v2/oss/files
COMMUNICATION_OSS_FOLDER_UPLOAD_PATH=/fitting/v2/oss/folders
COMMUNICATION_OSS_TIMEOUT_SEC=300

# Agent backend
AGENT_BACKEND=codex
AGENT_TIMEOUT_SEC=7200
AGENT_STREAM_LIMIT_BYTES=16777216
MAX_CONCURRENT_CODEX_WORKERS=1
CODEX_BIN=/usr/local/bin/codex
CODEX_LOAD_CLAUDE_PROJECT=true
CLAUDE_BIN=/usr/local/bin/claude
MCP_TIMEOUT=120000
MCP_CONNECT_TIMEOUT_MS=120000

# Python runtimes used by direct human-triggered fitting
DIRECT_FIT_PYTHON=/opt/conda/envs/mcp/bin/python
DIRECT_GALFITS_PYTHON=/opt/conda/envs/galfits/bin/python

# Logging
COMMUNICATION_SERVICE_MAX_LOG_BODY_CHARS=50000
